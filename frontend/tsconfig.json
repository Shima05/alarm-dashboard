{
  "compilerOptions": {
    "target": "es6",
    "lib": ["es2020", "dom"],
    "types": ["cypress"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true
  },
  "include": ["cypress/**/*.ts", "cypress/**/*.tsx"]
}
